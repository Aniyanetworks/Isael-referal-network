VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Canonical public URL of this site - used to build shareable /ref/ links and
# QR codes so they always point at the real domain, regardless of which host
# (localhost, a preview deploy, a custom domain) the admin/partner happens to
# be browsing from when they generate one. No trailing slash.
VITE_SITE_URL=http://localhost:5173
